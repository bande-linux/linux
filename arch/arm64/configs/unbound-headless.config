CONFIG_LOCALVERSION="-unbound"
CONFIG_ARCH_APPLE=y
# CONFIG_ARM64_4K_PAGES is not set
CONFIG_ARM64_16K_PAGES=y
# CONFIG_ARM64_64K_PAGES is not set
CONFIG_ARM_APPLE_CPUIDLE=y
CONFIG_ARM_APPLE_SOC_CPUFREQ=y
CONFIG_APPLE_M1_CPU_PMU=y
CONFIG_APPLE_PMGR_PWRSTATE=y
CONFIG_APPLE_PMGR_MISC=y
CONFIG_PINCTRL_APPLE_GPIO=y
CONFIG_APPLE_MAILBOX=y
CONFIG_APPLE_RTKIT=y
CONFIG_APPLE_SART=y
CONFIG_APPLE_DART=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIE_APPLE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_APPLE=y
CONFIG_MFD_MACSMC=y
CONFIG_GPIO_MACSMC=y
CONFIG_POWER_RESET_MACSMC=y
CONFIG_INPUT_MACSMC_INPUT=m
CONFIG_RTC_DRV_MACSMC=m
CONFIG_SENSORS_MACSMC_HWMON=m
CONFIG_SPMI=y
CONFIG_SPMI_APPLE=m
CONFIG_NVMEM_APPLE_EFUSES=m
CONFIG_NVMEM_APPLE_SPMI=m
CONFIG_I2C_APPLE=m
CONFIG_APPLE_WATCHDOG=m
CONFIG_SPI=y
CONFIG_SPI_APPLE=m
CONFIG_MTD=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_SPI_NOR=m
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_TIGON3=m
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM_VKMS=m
